    "起始与维持剂量受肾功能、尿酸水平和严重皮肤反应风险影响；仅按处方录入。" : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Starting and maintenance doses depend on kidney function, uric acid levels and the risk of severe skin reactions. Enter only the dose stated on the prescription."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "As doses inicial e de manutenção dependem da função renal, do nível de ácido úrico e do risco de reações cutâneas graves; introduza apenas a dose indicada na receita."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "起始及維持劑量會受腎功能、尿酸水平同嚴重皮膚反應風險影響；只按處方輸入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "起始與維持劑量受腎功能、尿酸值和嚴重皮膚不良反應風險影響；僅依處方輸入。"
          }
        }
      }
    },
