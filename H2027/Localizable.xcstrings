          }
        }
      }
    },
    "说明书常见成人起始用法示例：5 mg，每日一次；部分人群可能从2.5 mg开始。仅按处方确认。" : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The product information gives a common adult starting dose of 5 mg once daily; some people may start with 2.5 mg. Confirm the dose against the prescription."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Exemplo de dose inicial habitual em adultos indicada no folheto: 5 mg uma vez por dia; em algumas pessoas, pode iniciar-se com 2,5 mg. Confirme apenas segundo a receita."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "說明書常見成人起始用法例子：5 mg，每日一次；部分人士可能由2.5 mg開始。只按處方確認。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "說明書常見成人起始用法範例：5 mg，每日一次；部分族群可能從2.5 mg開始。僅依處方確認。"
          }
        }
      }
    },
    "说明书常见成人起始用法示例：10–20 mg，每日一次；治疗强度和相互作用需由医生确认。" : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The product information gives a common adult starting dose of 10–20 mg once daily. A doctor must confirm the treatment intensity and potential interactions."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Exemplo de dose inicial habitual em adultos indicada no folheto: 10–20 mg uma vez por dia; a intensidade do tratamento e as interações devem ser confirmadas pelo médico."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "說明書常見成人起始用法例子：10–20 mg，每日一次；治療強度同藥物相互作用須由醫生確認。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "說明書常見成人起始用法範例：10–20 mg，每日一次；治療強度和交互作用需由醫師確認。"
          }
        }
      }
    },
    "说明书常见成人起始用法示例：50 mg，每日一次；剂量需结合血压、肾功能和医嘱确认。" : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The product information gives a common adult starting dose of 50 mg once daily. Confirm the dose with a doctor based on blood pressure and kidney function."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Exemplo de dose inicial habitual em adultos indicada no folheto: 50 mg uma vez por dia; confirme a dose tendo em conta a tensão arterial, a função renal e as indicações médicas."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "說明書常見成人起始用法例子：50 mg，每日一次；劑量須按血壓、腎功能同醫生指示確認。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "說明書常見成人起始用法範例：50 mg，每日一次；劑量需依血壓、腎功能和醫囑確認。"
          }
        }
      }
    },
    "说明书常见成人起始用法示例：500 mg，每日一次，随晚餐服用；缓释片通常应整片吞服。仅按处方确认。" : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The product information gives a common adult starting dose of 500 mg once daily with the evening meal. Modified-release tablets should usually be swallowed whole. Confirm the dose against the prescription."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Exemplo de dose inicial habitual em adultos indicada no folheto: 500 mg uma vez por dia, com o jantar; os comprimidos de libertação prolongada devem geralmente ser engolidos inteiros. Confirme apenas segundo a receita."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "說明書常見成人起始用法例子：500 mg，每日一次，隨晚餐服用；緩釋片通常應該整片吞服。只按處方確認。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "說明書常見成人起始用法範例：500 mg，每日一次，隨晚餐服用；緩釋錠通常應整錠吞服。僅依處方確認。"
          }
        }
      }
    },
    "说明书常见成人起始用法示例：500 mg每日两次或850 mg每日一次；肾功能会影响是否适用。仅按处方确认。" : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The product information gives a common adult starting dose of 500 mg twice daily or 850 mg once daily. Kidney function affects whether this medicine is suitable. Confirm the dose against the prescription."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Exemplo de dose inicial habitual em adultos indicada no folheto: 500 mg duas vezes por dia ou 850 mg uma vez por dia; a função renal influencia a adequação do medicamento. Confirme apenas segundo a receita."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "說明書常見成人起始用法例子：500 mg每日兩次或850 mg每日一次；腎功能會影響藥物係咪適用。只按處方確認。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "說明書常見成人起始用法範例：500 mg每日兩次或850 mg每日一次；腎功能會影響是否適用。僅依處方確認。"
          }
        }
      }
    },
