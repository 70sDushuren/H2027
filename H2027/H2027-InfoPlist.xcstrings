    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "用于扫描药品包装文字，辅助填写药品名称和规格。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "H2027 uses the camera to scan text on medicine packaging and help fill in the medicine name and strength."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Permite digitalizar texto em embalagens de medicamentos para ajudar a preencher o nome e a dosagem."
          }
        },
        "yue-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "用嚟掃描藥品包裝上嘅文字，協助填寫藥品名稱同規格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "用於掃描藥品包裝上的文字，以輔助填寫藥品名稱和規格。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
